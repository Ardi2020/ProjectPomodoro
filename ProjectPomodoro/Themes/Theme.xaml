<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ===== Modernist tokens ===== -->
  <Color x:Key="BgColor">#F3F2F2</Color>
  <SolidColorBrush x:Key="Bg" Color="#F3F2F2"/>
  <SolidColorBrush x:Key="Surface" Color="#EAE9E9"/>
  <SolidColorBrush x:Key="Ink" Color="#201E1D"/>
  <SolidColorBrush x:Key="InkSoft" Color="#444141"/>
  <SolidColorBrush x:Key="TextMuted" Color="#605D5D"/>
  <SolidColorBrush x:Key="TextFaint" Color="#7D7979"/>
  <SolidColorBrush x:Key="Accent" Color="#EC3013"/>
  <SolidColorBrush x:Key="AccentHover" Color="#DD2B0F"/>
  <SolidColorBrush x:Key="AccentDeep" Color="#AE1800"/>
  <SolidColorBrush x:Key="AccentTint100" Color="#FFF2EF"/>
  <SolidColorBrush x:Key="AccentTint200" Color="#FFE0D9"/>
  <SolidColorBrush x:Key="OnAccent" Color="#F8F4F4"/>
  <SolidColorBrush x:Key="Track" Color="#D7D3D3"/>
  <SolidColorBrush x:Key="Divider" Color="#66201E1D"/>       <!-- garis 2px antar section -->
  <SolidColorBrush x:Key="DividerSoft" Color="#26201E1D"/>   <!-- garis 1px antar baris -->

  <!-- ===== Type: Archivo (fallback Segoe UI). Taruh Archivo-*.ttf di Assets/Fonts ===== -->
  <FontFamily x:Key="FontBody">/Assets/Fonts/#Archivo, Segoe UI</FontFamily>

  <Style x:Key="Kicker" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="ExtraBold"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
  </Style>
  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontWeight" Value="ExtraBold"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  </Style>
  <Style x:Key="TimerDigits" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
    <Setter Property="FontWeight" Value="ExtraBold"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  </Style>

  <!-- ===== Buttons: radius 0, label rata kiri ===== -->
  <Style x:Key="BtnBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="12,9,16,9"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{StaticResource Accent}"/>
    <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHover}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource AccentTint200}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentDeep}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Surface}"/></Trigger>
    </Style.Triggers>
  </Style>

  <!-- Progress bar: flat, radius 0 -->
  <Style x:Key="FlatProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="4"/>
    <Setter Property="Background" Value="{StaticResource Track}"/>
    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
</ResourceDictionary>
