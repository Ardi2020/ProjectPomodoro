<Window x:Class="ProjectPomodoro.BreakWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Break" Icon="/Assets/app.ico" Width="400" Height="64" WindowStyle="None" Topmost="True" Background="{StaticResource OnAccent}" Foreground="{StaticResource Ink}" ResizeMode="NoResize">
    <Border BorderBrush="{StaticResource Ink}" BorderThickness="2" Padding="18,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="RemainingText" Text="05:00" FontSize="28" FontWeight="ExtraBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="ContextText" Text="BREAK · 5 MIN" Style="{StaticResource Kicker}" Foreground="{StaticResource TextMuted}"/><ProgressBar Height="4" Maximum="300" Value="0" Background="{StaticResource Track}" Foreground="{StaticResource Ink}" BorderThickness="0" Margin="0,5,12,0"/></StackPanel><Button Grid.Column="2" Content="Skip" Click="Stop_Click" Style="{StaticResource SecondaryButton}" Padding="14,6"/></Grid></Border>
</Window>