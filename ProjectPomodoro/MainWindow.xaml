<Window x:Class="ProjectPomodoro.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Project Pomodoro" Icon="/Assets/app.ico" Height="760" Width="1320" MinHeight="600" MinWidth="1000" Background="{StaticResource Bg}" Foreground="{StaticResource Ink}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,2" Padding="30,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="14" Height="14" Background="{StaticResource Accent}" Margin="0,0,18,0"/><TextBlock Text="PROJECT POMODORO" FontFamily="{StaticResource FontBody}" FontSize="21" FontWeight="ExtraBold"/></StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="2"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,2" Padding="32,36,32,22"><StackPanel Orientation="Horizontal"><TextBlock Text="PROJECTS" Style="{StaticResource Kicker}"/><TextBlock Text="" Margin="0,0,8,0"/><TextBlock x:Name="ProjectCount" Text="" Foreground="{StaticResource TextFaint}" FontSize="14"/></StackPanel></Border>
                <ListBox x:Name="ProjectList" SelectionChanged="ProjectList_SelectionChanged" BorderThickness="0" Background="Transparent" Padding="0" DisplayMemberPath="Title" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="32,22"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{StaticResource DividerSoft}"/><Setter Property="FontFamily" Value="{StaticResource FontBody}"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentTint100}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="BorderThickness" Value="4,0,0,1"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
                </ListBox>
                <Button DockPanel.Dock="Bottom" Content="Settings" Click="Settings_Click" Style="{StaticResource GhostButton}" Padding="32,22" BorderBrush="{StaticResource Divider}" BorderThickness="0,2,0,0"/>
                <Button DockPanel.Dock="Top" Content="+ New project" Click="NewProject_Click" Style="{StaticResource GhostButton}" Foreground="{StaticResource Accent}" Padding="32,24"/>
            </DockPanel>
            <Border Grid.Column="1" Background="{StaticResource Divider}"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="232"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,2" Padding="50,42,34,28">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock x:Name="ProjectTitle" Text="Select a project" Style="{StaticResource H1}" TextWrapping="Wrap"/><TextBlock Text="IN PROGRESS" Background="{StaticResource AccentTint200}" Foreground="{StaticResource AccentDeep}" FontSize="10" FontWeight="ExtraBold" Padding="8,5" HorizontalAlignment="Left" Margin="0,12,0,22"/><StackPanel Orientation="Horizontal"><ProgressBar Width="180" Style="{StaticResource FlatProgress}"/><TextBlock x:Name="ProjectProgress" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="18,-5,0,0"/></StackPanel></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="+ Task" Click="AddTask_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button Content="+ Milestone" Click="AddMilestone_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="History" Click="History_Click" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/><Button Content="..." Style="{StaticResource GhostButton}"><Button.ContextMenu><ContextMenu><MenuItem Header="Mark complete" Click="CompleteProject_Click"/><MenuItem Header="Archive" Click="ArchiveProject_Click"/><MenuItem Header="Settings" Click="Settings_Click"/></ContextMenu></Button.ContextMenu></Button></StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="WorkItemsPanel"/></ScrollViewer>
            </Grid>
            <Border Grid.Column="3" Background="{StaticResource Divider}"/>
            <DockPanel Grid.Column="4">
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,2" Padding="40,36,30,22"><TextBlock Text="FOCUS SESSION" Style="{StaticResource Kicker}"/></Border>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Divider}" BorderThickness="0,2,0,0" Padding="40,32,30,26"><StackPanel><TextBlock Text="TODAY" Style="{StaticResource Kicker}" Margin="0,0,0,16"/><Border BorderBrush="{StaticResource DividerSoft}" BorderThickness="0,1,0,0"><TextBlock Text="Pomodoro selesai     0" FontSize="13" Padding="0,10"/></Border><Border BorderBrush="{StaticResource DividerSoft}" BorderThickness="0,1,0,0"><TextBlock Text="Waktu fokus          0 min" FontSize="13" Padding="0,10"/></Border><Border BorderBrush="{StaticResource DividerSoft}" BorderThickness="0,1,0,0"><TextBlock Text="Task selesai          0" FontSize="13" Padding="0,10"/></Border></StackPanel></Border>
                <StackPanel Margin="40,48,30,0"><TextBlock Text="Tidak ada sesi aktif" FontSize="18" FontWeight="Bold"/><TextBlock Text="Pilih task lalu Start 25 min" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
