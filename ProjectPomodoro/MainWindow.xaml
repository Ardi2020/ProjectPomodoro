<Window x:Class="ProjectPomodoro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectPomodoro"
        mc:Ignorable="d"
        Title="Project Pomodoro" Height="720" Width="1180" MinHeight="600" MinWidth="900" Background="#F5F2EC">
    <Window.Resources><Style x:Key="ActionButton" TargetType="Button"><Setter Property="Background" Value="#D56B45"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="16,9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="Bold"/></Style><Style x:Key="QuietButton" TargetType="Button"><Setter Property="Background" Value="#E7F1ED"/><Setter Property="Foreground" Value="#153B3A"/><Setter Property="Padding" Value="12,8"/><Setter Property="BorderThickness" Value="0"/></Style></Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,22"><StackPanel DockPanel.Dock="Left"><TextBlock Text="PROJECT POMODORO" FontSize="26" FontWeight="Bold" Foreground="#153B3A"/><TextBlock Text="Focus on the work that moves the project." Foreground="#63706C" Margin="0,4,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="+ New project" Click="NewProject_Click" Style="{StaticResource ActionButton}"/><Button Content="Settings" Click="Settings_Click" Margin="10,0,0,0" Style="{StaticResource QuietButton}"/></StackPanel></DockPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" Padding="18"><DockPanel><TextBlock DockPanel.Dock="Top" Text="PROJECTS" FontWeight="Bold" Foreground="#63706C" Margin="0,0,0,12"/><ListBox x:Name="ProjectList" SelectionChanged="ProjectList_SelectionChanged" BorderThickness="0" Background="Transparent" DisplayMemberPath="Title"/></DockPanel></Border>
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="8" Padding="28"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel><StackPanel><TextBlock x:Name="ProjectTitle" Text="Select a project" FontSize="30" FontWeight="Bold" Foreground="#153B3A"/><TextBlock x:Name="ProjectProgress" Foreground="#63706C" Margin="0,6,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Add milestone" Click="AddMilestone_Click" Style="{StaticResource QuietButton}"/><Button Content="Add task" Click="AddTask_Click" Margin="8,0,0,0" Style="{StaticResource ActionButton}"/><Button Content="History" Click="History_Click" Margin="8,0,0,0" Style="{StaticResource QuietButton}"/><Button Content="Mark complete" Click="CompleteProject_Click" Margin="8,0,0,0" Style="{StaticResource QuietButton}"/><Button Content="Archive" Click="ArchiveProject_Click" Margin="8,0,0,0" Style="{StaticResource QuietButton}"/></StackPanel></DockPanel>
                <Border Grid.Row="1" Background="#E7F1ED" Padding="14" Margin="0,24,0,18"><TextBlock Text="Start from a concrete work item. Focus completion never marks work done automatically." Foreground="#153B3A" TextWrapping="Wrap"/></Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="WorkItemsPanel"/></ScrollViewer>
            </Grid></Border>
        </Grid>
    </Grid>
</Window>
