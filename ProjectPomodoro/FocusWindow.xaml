<Window x:Class="ProjectPomodoro.FocusWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Focus" Width="360" Height="280" WindowStyle="ToolWindow" Topmost="True" Background="#153B3A" Foreground="White" ResizeMode="NoResize">
    <Border Padding="24"><StackPanel>
        <TextBlock Text="FOCUS" FontSize="12" FontWeight="Bold" Foreground="#F2B880"/>
        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" Margin="0,12,0,4" TextWrapping="Wrap"/>
        <TextBlock x:Name="WhyText" Foreground="#C7D8D1" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock x:Name="RemainingText" Text="25:00" FontSize="48" FontWeight="Bold"/>
        <TextBlock x:Name="MotivationText" Foreground="#F2B880" TextWrapping="Wrap" Margin="0,8,0,14"/>
        <Button Content="Stop focus" Click="Stop_Click" Width="110" HorizontalAlignment="Left" Padding="10,7"/>
    </StackPanel></Border>
</Window>